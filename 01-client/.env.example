# Client Application Environment Configuration Example
# Copy to .env and configure for your environment. Never commit real credentials.

# Application Base URL (without trailing slash)
APP_URL=https://app.example.com

# Multi-tenant context (default 1)
TENANT_ID=1

# Application Secret Key for tokens and session security (cryptographically random string)
APP_SECRET=change-this-to-a-secure-random-32-byte-secret

# Cron Security Token (must match header/query when invoking cron.php via HTTP)
CRON_SECRET=change-this-to-a-secure-random-cron-token

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kohevo_client
DB_USER=kohevo_db_user
DB_PASS=change-this-db-password
DB_CHARSET=utf8mb4

# Central Licensing Server Configuration
LICENSE_SERVER_URL=https://licensing.example.com
LICENSE_SERVER_PUBLIC_KEY=YOUR_ED25519_PUBLIC_KEY_BASE64_HERE
LICENSE_PRODUCT=kohevo
LICENSE_KEY=KOH-XXXX-XXXX-XXXX-XXXX
