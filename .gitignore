# Environment & secrets
.env
.env.*
.installed
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt

# Runtime logs & local data
*.log
01-client/data/*
!01-client/data/.gitkeep
!01-client/data/.htaccess
02-licensing/data/*
!02-licensing/data/.gitkeep
!02-licensing/data/.htaccess

# Local database backups
01-client/db_backups/*
!01-client/db_backups/.gitkeep
!01-client/db_backups/.htaccess
02-licensing/db_backups/*
!02-licensing/db_backups/.gitkeep
!02-licensing/db_backups/.htaccess
*.sqlite
*.sqlite3
*.db

# OS & editor artifacts
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary & cache files
tmp/
temp/
.phpunit.result.cache

# Built deployment packages (rebuild from the tree; never version them)
production-artifacts/*.zip
*.zip

# Local assistant/editor state (machine-specific)
.claude/

# Sheets EmbedStyle writes while a render runs (tests, local preview).
01-client/uploads/studio-embed/

# Studio's scheduled-publish sweep stamp (written on page requests).
01-client/storage/.studio-schedule-sweep

# Site bundles keep their photos out of git (each bundle refetches or copies them).
# No trailing slash, so a worktree's symlink to the folder is ignored too.
01-client/sites/*/media
